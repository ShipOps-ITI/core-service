// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ShipState {
  ACTIVE
  MAINTENANCE
  DOCKED
  AT_SEA
}

//
// COMPANY
//

model Company {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  country       String
  contactEmail  String
  phone         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fleets        Fleet[]
  ships         Ship[]

  @@map("companies")
}

//
// FLEET
//

model Fleet {
  id              Int      @id @default(autoincrement())

  companyId       Int

  name            String
  description     String?

  // References Auth Service users (integer IDs)
  managedByUserId Int
  createdByUserId Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ships            Ship[]

  @@unique([companyId, name])

  @@index([companyId])

  @@map("fleets")
}

//
// SHIP
//

model Ship {
  id                  Int         @id @default(autoincrement())

  companyId           Int
  fleetId             Int

  name                String

  imoNumber           String?     @unique
  mmsiNumber          String?     @unique

  flag                String

  capacityTonnage     Float

  shipType            String?

  availabilityState   ShipState   @default(ACTIVE)

  currentLatitude     Float?
  currentLongitude    Float?
  lastAisUpdateAt     DateTime?

  lengthMeters        Float?
  widthMeters         Float?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fleet               Fleet       @relation(fields: [fleetId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([fleetId])
  @@index([availabilityState])

  @@map("ships")
}

//
// PORT
//

model Port {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  countryCode String?
  unLocode    String?  @unique
  latitude    Float
  longitude   Float
  source      String   @default("MANUAL")
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, country])
  @@index([country])
  @@index([unLocode])
  @@map("ports")
}
