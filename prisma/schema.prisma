// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ShipState {
  ACTIVE
  MAINTENANCE
  DOCKED
  AT_SEA
}

//
// COMPANY
//

model Company {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  country       String
  contactEmail  String
  phone         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fleets        Fleet[]
  ships         Ship[]

  @@map("companies")
}

//
// FLEET
//

model Fleet {
  id              Int      @id @default(autoincrement())

  companyId       Int

  name            String
  description     String?

  // References Auth Service users (integer IDs)
  managedByUserId Int
  createdByUserId Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ships            Ship[]

  @@unique([companyId, name])

  @@index([companyId])

  @@map("fleets")
}

//
// SHIP
//

model Ship {
  id                  Int         @id @default(autoincrement())

  companyId           Int
  fleetId             Int

  name                String

  imoNumber           String?
  mmsiNumber          String?

  flag                String

  capacityTonnage     Float

  shipType            String?

  availabilityState   ShipState   @default(ACTIVE)

  currentLatitude     Float?
  currentLongitude    Float?
  lastAisUpdateAt     DateTime?

  lengthMeters        Float?
  widthMeters         Float?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fleet               Fleet       @relation(fields: [fleetId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([fleetId])
  @@index([availabilityState])
  @@unique([companyId, imoNumber])
  @@unique([companyId, mmsiNumber])

  @@map("ships")
}

//
// PORT
//

model Port {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  countryCode String?
  unLocode    String?  @unique
  latitude    Float
  longitude   Float
  source      String   @default("MANUAL")
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, country])
  @@index([country])
  @@index([unLocode])
  @@map("ports")
}

// Singleton record written by the dedicated tracking worker and read by the
// operations dashboard. It deliberately contains no vessel data.
model TrackingWorkerHealth {
  id                       Int       @id @default(1)
  lastPollStartedAt        DateTime?
  lastSuccessfulApiCallAt  DateTime?
  lastPositionUpdateAt     DateTime?
  lastFailureAt            DateTime?
  lastError                String?
  quotaCooldownUntil       DateTime?
  totalPolls               Int       @default(0)
  successfulPolls          Int       @default(0)
  failedPolls              Int       @default(0)
  retryCount               Int       @default(0)
  quotaFailureCount        Int       @default(0)
  trackedShipCount         Int       @default(0)
  returnedPositionCount    Int       @default(0)
  updatedShipCount         Int       @default(0)
  updatedAt                DateTime  @updatedAt

  @@map("tracking_worker_health")
}
