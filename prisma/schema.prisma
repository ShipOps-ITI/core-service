// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ShipState {
  ACTIVE
  MAINTENANCE
  DOCKED
  AT_SEA
}

//
// COMPANY
//

model Company {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  country       String
  contactEmail  String
  phone         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fleets        Fleet[]
  ships         Ship[]

  @@map("companies")
}

//
// FLEET
//

model Fleet {
  id              String   @id @default(uuid()) @db.Uuid

  companyId       String   @db.Uuid

  name            String
  description     String?

  // References Auth Service only (UUIDs)
  managedByUserId String   @db.Uuid
  createdByUserId String   @db.Uuid

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ships            Ship[]

  @@unique([companyId, name])

  @@index([companyId])

  @@map("fleets")
}

//
// SHIP
//

model Ship {
  id                  String      @id @default(uuid()) @db.Uuid

  companyId           String      @db.Uuid
  fleetId             String?     @db.Uuid

  name                String

  imoNumber           String?     @unique

  flag                String

  capacityTonnage     Float

  shipType            String?

  availabilityState   ShipState   @default(ACTIVE)

  currentLatitude     Float?
  currentLongitude    Float?

  lengthMeters        Float?
  widthMeters         Float?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fleet               Fleet?      @relation(fields: [fleetId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([fleetId])
  @@index([availabilityState])

  @@map("ships")
}