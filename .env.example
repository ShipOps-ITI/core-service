DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shipops_core"

# Must match auth-service JWT_SECRET so Core can verify login access tokens.
JWT_SECRET=replace_with_the_same_secret_used_by_auth_service

# VesselAPI live-position polling
VESSELAPI_KEY=your_vesselapi_key
VESSELAPI_POLL_INTERVAL_MS=300000

# Optional legacy AISStream worker
AISSTREAM_API_KEY=your_aisstream_key
